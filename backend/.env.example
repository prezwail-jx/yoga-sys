APP_ENV=development
APP_NAME=yoga-sys-backend
LOG_LEVEL=INFO
LOG_FORMAT=console

OTEL_ENABLED=true
OTEL_SERVICE_NAME=yoga-sys-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0

DATABASE_URL=postgresql+psycopg://yoga:yoga@localhost:5432/yoga_sys
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- WeChat Mini Program (任务 3) ---
# 生产环境: APP_ENV=production 时禁止 WECHAT_PROVIDER=fake
#             WECHAT_PROVIDER=real 时 WECHAT_APP_SECRET 和 WECHAT_IDENTITY_PEPPER 必填
#             WECHAT_IDENTITY_PEPPER 最低 32 字符，且不得与 JWT_SECRET 相同
WECHAT_AUTH_ENABLED=false
WECHAT_PROVIDER=fake
WECHAT_APP_ID=wx9fc61b966bf4e207
WECHAT_APP_SECRET=
WECHAT_IDENTITY_PEPPER=
WECHAT_SOURCE_FINGERPRINT_PEPPER=
WECHAT_API_TIMEOUT_SECONDS=5
WECHAT_BINDING_CHALLENGE_MINUTES=10
WECHAT_BINDING_MAX_ATTEMPTS=5
WECHAT_BINDING_SOURCE_MAX_ATTEMPTS=20
WECHAT_BINDING_SOURCE_WINDOW_SECONDS=600

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
COACH_USERNAME=coach
COACH_PASSWORD=coach123
