<view class="page-shell"><view class="admin-header"><text class="eyebrow">基础资料</text><view class="title">课程、教室与教练</view></view><view class="admin-actions"><button data-tab="courses" bindtap="select">课程</button><button data-tab="rooms" bindtap="select">教室</button><button data-tab="coaches" bindtap="select">教练</button><button bindtap="create">新增</button></view><text wx:if="{{error}}" class="admin-error">{{error}}</text><async-state wx:if="{{mode === 'loading' || mode === 'error'}}" mode="{{mode}}" message="{{message}}" bindretry="load"/><view wx:elif="{{mode === 'empty'}}" class="admin-empty">{{message}}</view><view wx:else><view wx:for="{{items}}" wx:key="id" class="admin-card"><view class="admin-card__head"><text class="admin-card__title">{{item.name}}</text><text class="admin-badge">{{item.enabled ? '已启用' : '已停用'}}</text></view><text class="admin-card__meta">{{item.detail}}</text><view class="admin-actions"><button data-id="{{item.id}}" bindtap="rename">改名</button><button data-id="{{item.id}}" data-enabled="{{item.enabled}}" bindtap="toggle">{{item.enabled ? '停用' : '启用'}}</button><button wx:if="{{tab === 'coaches' && !item.hasAccount}}" data-id="{{item.id}}" bindtap="account">开通账号</button><button wx:if="{{tab === 'coaches' && item.hasAccount}}" data-id="{{item.id}}" bindtap="reset">重置密码</button></view></view></view></view>
