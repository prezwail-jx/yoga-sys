<view class="page-shell"><view class="admin-header"><text class="eyebrow">会员与卡项</text><view class="title">会员管理</view></view><view class="admin-toolbar"><input class="admin-input" value="{{keyword}}" bindinput="updateKeyword" confirm-type="search" bindconfirm="load" placeholder="姓名或手机号"/><button class="admin-button" bindtap="load">搜索</button></view><button class="admin-button admin-button--light" bindtap="toggleCreate">{{showCreate ? '收起新增' : '新增会员'}}</button><view wx:if="{{showCreate}}" class="admin-form"><text class="admin-label">姓名</text><input class="admin-input" data-field="name" value="{{form.name}}" bindinput="updateField"/><text class="admin-label">手机号</text><input class="admin-input" data-field="phone" value="{{form.phone}}" type="number" bindinput="updateField"/><text class="admin-label">入会日期</text><picker mode="date" value="{{form.joinDate}}" bindchange="updateDate"><view class="admin-picker">{{form.joinDate || '请选择日期'}}</view></picker><text wx:if="{{error}}" class="admin-error">{{error}}</text><button class="admin-button" loading="{{pending}}" disabled="{{pending}}" bindtap="create">确认新增</button></view><async-state wx:if="{{mode === 'loading' || mode === 'error'}}" mode="{{mode}}" message="{{message}}" bindretry="load"/><view wx:elif="{{mode === 'empty'}}" class="admin-empty">{{message}}</view><view wx:else><view wx:for="{{members}}" wx:key="id" class="admin-card" data-id="{{item.id}}" bindtap="open"><view class="admin-card__head"><text class="admin-card__title">{{item.name}}</text><text class="admin-badge">{{item.statusLabel}}</text></view><text class="admin-card__meta">{{item.phone}} · {{item.hasAccount ? item.username : '未开通账号'}}</text><text wx:for="{{item.cardLabels}}" wx:key="*this" class="admin-card__meta">{{item}}</text><text wx:if="{{!item.cardLabels.length}}" class="admin-card__meta">暂无持卡</text></view></view></view>
