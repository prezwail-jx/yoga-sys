<view class="page-shell"><view class="admin-header"><text class="eyebrow">卡产品</text><view class="title">产品管理</view><view class="muted">后端未提供删除接口，以停用代替删除，避免影响历史会员卡。</view></view><button class="admin-button admin-button--light" bindtap="toggleForm">{{showForm ? '收起表单' : '新建卡产品'}}</button><view wx:if="{{showForm}}" class="admin-form"><text class="admin-label">产品名称</text><input class="admin-input" data-field="name" value="{{form.name}}" bindinput="field"/><text class="admin-label">类型</text><picker range="{{typeNames}}" value="{{typeIndex}}" bindchange="chooseType"><view class="admin-picker">{{typeNames[typeIndex]}}</view></picker><text class="admin-label">价格</text><input class="admin-input" type="digit" data-field="price" value="{{form.price}}" bindinput="field"/><text class="admin-label">总次数</text><input class="admin-input" type="number" data-field="totalTimes" value="{{form.totalTimes}}" bindinput="field" placeholder="期限卡可不填"/><text class="admin-label">有效期天数</text><input class="admin-input" type="number" data-field="validDays" value="{{form.validDays}}" bindinput="field" placeholder="次数卡必填"/><text class="admin-label">开卡方式</text><picker range="{{activationNames}}" bindchange="chooseActivation"><view class="admin-picker">{{form.activationMode === 'immediate' ? '购卡即开' : '首次约课开卡'}}</view></picker><text wx:if="{{error}}" class="admin-error">{{error}}</text><button class="admin-button" loading="{{pending}}" disabled="{{pending}}" bindtap="create">保存产品</button></view><async-state wx:if="{{mode === 'loading' || mode === 'error'}}" mode="{{mode}}" message="{{message}}" bindretry="load"/><view wx:elif="{{mode === 'empty'}}" class="admin-empty">{{message}}</view><view wx:else><view wx:for="{{products}}" wx:key="id" class="admin-card"><view class="admin-card__head"><text class="admin-card__title">{{item.name}}</text><text class="admin-badge">{{item.enabledLabel}}</text></view><text class="admin-card__meta">{{item.typeLabel}} · ¥{{item.price}} · {{item.ruleLabel}}</text><view class="admin-actions"><button data-id="{{item.id}}" bindtap="rename">修改名称</button><button data-id="{{item.id}}" bindtap="editRules">修改规则</button><button data-id="{{item.id}}" data-enabled="{{item.enabled}}" bindtap="toggle">{{item.enabled ? '停用' : '启用'}}</button></view></view></view></view>
