<view class="page-shell"><view class="admin-header"><text class="eyebrow">统计报表</text><view class="title">经营分析</view></view><view class="admin-toolbar"><picker mode="date" value="{{dateFrom}}" bindchange="dateFrom"><view class="admin-picker">{{dateFrom || '开始日期'}}</view></picker><picker mode="date" value="{{dateTo}}" bindchange="dateTo"><view class="admin-picker">{{dateTo || '结束日期'}}</view></picker></view><text wx:if="{{error}}" class="admin-error">{{error}}</text><text wx:if="{{exportFeedback}}" class="admin-card__meta">{{exportFeedback}}</text><async-state wx:if="{{mode !== 'ready'}}" mode="{{mode}}" message="{{message}}" bindretry="load"/><block wx:else><view class="admin-grid"><view wx:for="{{metrics}}" wx:key="label" class="admin-metric"><text class="muted">{{item.label}}</text><text class="admin-metric__value">{{item.value}}</text></view></view><view class="admin-form"><picker range="{{trendNames}}" value="{{trendIndex}}" bindchange="trend"><view class="admin-picker">趋势：{{trendNames[trendIndex]}}</view></picker><view wx:for="{{points}}" wx:key="bucket" class="admin-card__head"><text>{{item.bucket}}</text><text>{{item.value}}</text></view><view wx:if="{{!points.length}}" class="admin-empty">当前筛选无趋势数据</view></view><view class="admin-form"><picker range="{{detailNames}}" value="{{detailIndex}}" bindchange="detail"><view class="admin-picker">明细：{{detailNames[detailIndex]}}</view></picker><text wx:for="{{rows}}" wx:key="index" class="admin-card__meta">{{index + 1}}. {{item}}</text><view wx:if="{{!rows.length}}" class="admin-empty">当前筛选无明细</view><button class="admin-button admin-button--light" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportReport">导出并预览 Excel</button></view></block></view>
