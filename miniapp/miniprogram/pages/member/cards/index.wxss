@import "../../../styles/member.wxss";

.cards-stack {
  margin-top: 34rpx;
}

.member-pass {
  box-sizing: border-box;
  min-height: 310rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #173f35, #2e6958);
  color: #fffaf1;
  box-shadow: 0 20rpx 50rpx rgba(23, 63, 53, 0.18);
}

.member-pass--frozen,
.member-pass--expired,
.member-pass--closed {
  background: linear-gradient(145deg, #52605c, #78847f);
}

.member-pass__type {
  color: #f0bd93;
  font-size: 24rpx;
}

.member-pass__name,
.member-pass__balance {
  display: block;
}

.member-pass__name {
  margin-top: 30rpx;
  font-family: Georgia, "Noto Serif CJK SC", serif;
  font-size: 40rpx;
}

.member-pass__balance {
  margin: 18rpx 0 26rpx;
  font-size: 30rpx;
}

.member-pass .member-card__meta {
  color: rgba(255, 250, 241, 0.72);
}
