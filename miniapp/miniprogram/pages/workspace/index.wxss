.workspace__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.workspace__account {
  min-width: 112rpx;
  margin: 0;
  border: 1rpx solid rgba(23, 63, 53, 0.25);
  border-radius: 999rpx;
  background: transparent;
  color: #173f35;
  font-size: 24rpx;
}

.workspace__grid {
  margin-top: 52rpx;
}

.workspace__item {
  display: grid;
  grid-template-columns: 76rpx 1fr;
  margin-bottom: 22rpx;
  padding: 30rpx;
  border-left: 8rpx solid #bb6b3d;
  border-radius: 0 24rpx 24rpx 0;
  background: rgba(255, 255, 255, 0.78);
}

.workspace__number {
  grid-row: 1 / span 2;
  color: #bb6b3d;
  font-family: Georgia, serif;
  font-size: 30rpx;
}

.workspace__label {
  font-family: Georgia, "Noto Serif CJK SC", serif;
  font-size: 34rpx;
}

.workspace__description {
  margin-top: 8rpx;
  color: #64736e;
  font-size: 24rpx;
}
