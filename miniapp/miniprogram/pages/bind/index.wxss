.bind-form__label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #64736e;
  font-size: 24rpx;
}

.bind-form__input {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(23, 63, 53, 0.22);
  border-radius: 18rpx;
  background: #fff;
  font-size: 30rpx;
}

.bind-form__error {
  display: block;
  margin-top: 20rpx;
  color: #a13f32;
  font-size: 24rpx;
}

.bind-form__restart {
  margin-top: 18rpx;
  background: transparent;
  color: #64736e;
  font-size: 24rpx;
}
