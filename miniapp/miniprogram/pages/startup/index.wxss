.startup {
  overflow: hidden;
  position: relative;
}

.startup__orbit {
  position: absolute;
  top: 110rpx;
  right: -180rpx;
  width: 520rpx;
  height: 520rpx;
  border: 1rpx solid rgba(187, 107, 61, 0.35);
  border-radius: 50%;
  box-shadow: inset 0 0 0 70rpx rgba(187, 107, 61, 0.04);
}

.startup__signed-out,
.startup__login-panel {
  position: relative;
  margin-top: 180rpx;
  padding: 36rpx;
  border: 1rpx solid rgba(23, 63, 53, 0.15);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
}

.startup__login-panel {
  margin-top: 72rpx;
}

.startup__label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #64736e;
  font-size: 24rpx;
}

.startup__input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(23, 63, 53, 0.22);
  border-radius: 18rpx;
  background: #fff;
  color: #18312b;
  caret-color: #18312b;
  -webkit-text-fill-color: #18312b;
  font-size: 30rpx;
  line-height: 88rpx;
}

.startup__error {
  display: block;
  margin-top: 20rpx;
  color: #a13f32;
  font-size: 24rpx;
}

.startup__divider {
  position: relative;
  margin: 28rpx 0 18rpx;
  border-top: 1rpx solid rgba(23, 63, 53, 0.14);
  text-align: center;
}

.startup__divider text {
  position: relative;
  top: -18rpx;
  padding: 0 18rpx;
  background: #faf9f5;
  color: #8a9994;
  font-size: 22rpx;
}

.startup__wechat-button {
  border: 1rpx solid #173f35;
  border-radius: 999rpx;
  background: transparent;
  color: #173f35;
  font-size: 28rpx;
}

.startup__hint {
  display: block;
  margin-top: 18rpx;
  color: #64736e;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
