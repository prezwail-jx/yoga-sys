.startup {
  overflow: hidden;
  position: relative;
}

.startup__orbit {
  position: absolute;
  top: 110rpx;
  right: -180rpx;
  width: 520rpx;
  height: 520rpx;
  border: 1rpx solid rgba(187, 107, 61, 0.35);
  border-radius: 50%;
  box-shadow: inset 0 0 0 70rpx rgba(187, 107, 61, 0.04);
}

.startup__signed-out {
  position: relative;
  margin-top: 180rpx;
  padding: 36rpx;
  border: 1rpx solid rgba(23, 63, 53, 0.15);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
}
