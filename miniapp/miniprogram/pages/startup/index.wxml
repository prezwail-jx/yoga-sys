<view class="page-shell startup">
  <text class="eyebrow">瑜伽馆服务平台</text>
  <view class="startup__orbit"></view>
  <view wx:if="{{mode === 'login_choice'}}" class="startup__login-panel">
    <view class="title">{{release ? '管理员登录' : '进入瑜伽空间'}}</view>
    <view class="muted">{{release ? '正式版账号密码入口仅供管理员使用，会员和教练请使用微信登录。' : '开发版和体验版可使用会员、教练或管理员测试账号登录，不会创建微信绑定。'}}</view>
    <text class="startup__label">用户名</text>
    <input class="startup__input" value="{{username}}" maxlength="64" cursor-spacing="24" bindinput="updateUsername" placeholder="{{release ? '请输入管理员用户名' : '请输入用户名'}}" />
    <text class="startup__label">密码</text>
    <input class="startup__input" value="{{password}}" password maxlength="128" cursor-spacing="24" bindinput="updatePassword" placeholder="请输入密码" />
    <text wx:if="{{error}}" class="startup__error">{{error}}</text>
    <button class="primary-button" loading="{{pending}}" disabled="{{pending || !username || !password}}" bindtap="passwordLogin">账号密码登录</button>
    <view class="startup__divider"><text>会员与教练</text></view>
    <button class="startup__wechat-button" disabled="{{pending}}" bindtap="start">微信快捷登录</button>
    <text class="startup__hint">管理员不进行微信绑定；微信登录仅用于会员和教练。</text>
  </view>
  <view wx:if="{{mode === 'signed_out'}}" class="startup__signed-out">
    <view class="title">已退出登录</view>
    <view class="muted">微信账号绑定仍然保留。需要使用时，请重新登录。</view>
    <button class="primary-button" bindtap="start">微信登录</button>
  </view>
  <async-state wx:if="{{mode === 'loading' || mode === 'error'}}" mode="{{mode}}" message="{{message}}" bindretry="start" />
</view>
