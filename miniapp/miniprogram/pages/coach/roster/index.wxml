<view class="page-shell">
  <text class="eyebrow">Attendance</text>
  <view class="title">{{session ? session.courseName : '签到名册'}}</view>
  <text wx:if="{{session}}" class="muted">{{session.startAt}} · {{session.roomName}} · {{items.length}} 人预约</text>
  <view wx:if="{{feedback}}" class="coach-feedback">{{feedback}}</view>
  <async-state wx:if="{{mode !== 'ready'}}" mode="{{mode}}" message="{{message}}" bindretry="load" />
  <view wx:else>
    <view wx:for="{{items}}" wx:key="id" wx:for-item="booking" class="coach-card">
      <text class="coach-card__title">{{booking.memberName}}</text>
      <text class="coach-card__meta">{{booking.status}} · {{booking.checkInMessage}}</text>
      <button wx:if="{{booking.canCheckIn}}" class="coach-button" loading="{{pendingId === booking.id}}" disabled="{{pendingId !== ''}}" data-id="{{booking.id}}" data-name="{{booking.memberName}}" bindtap="checkIn">确认签到</button>
    </view>
  </view>
</view>
