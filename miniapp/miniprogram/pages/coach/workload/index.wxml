<view class="page-shell">
  <text class="eyebrow">私教工作</text>
  <view class="title">私教申请</view>
  <scroll-view scroll-x class="coach-tabs">
    <button wx:for="{{statusTabs}}" wx:key="value" class="coach-tab {{status === item.value ? 'coach-tab--active' : ''}}" data-status="{{item.value}}" bindtap="switchStatus">{{item.label}}</button>
  </scroll-view>
  <view wx:if="{{feedback}}" class="coach-feedback">{{feedback}}</view>
  <async-state wx:if="{{mode !== 'ready'}}" mode="{{mode}}" message="{{message}}" bindretry="load" />
  <view wx:else>
    <view wx:for="{{items}}" wx:key="id" wx:for-item="booking" class="coach-card">
      <text class="coach-card__title">{{booking.memberName}}</text>
      <text class="coach-card__meta">{{booking.dateLabel}} · {{booking.timeLabel}}</text>
      <text wx:if="{{booking.memberMessage}}" class="coach-card__meta">会员留言：{{booking.memberMessage}}</text>
      <text wx:if="{{booking.rejectionReason}}" class="coach-card__meta">拒绝原因：{{booking.rejectionReason}}</text>
      <view wx:if="{{booking.status === 'pending'}}" class="coach-actions">
        <button class="coach-button" loading="{{pendingId === booking.id}}" disabled="{{pendingId !== ''}}" data-id="{{booking.id}}" data-name="{{booking.memberName}}" bindtap="confirm">确认</button>
        <button class="coach-button coach-button--secondary" disabled="{{pendingId !== ''}}" data-id="{{booking.id}}" bindtap="reject">拒绝</button>
      </view>
      <button wx:if="{{booking.status === 'confirmed'}}" class="coach-button" data-id="{{booking.id}}" bindtap="lesson">填写课时并签到</button>
    </view>
  </view>
  <button wx:if="{{mode === 'ready' && items.length < total}}" class="coach-button coach-button--secondary" bindtap="loadMore">加载更多</button>
</view>
