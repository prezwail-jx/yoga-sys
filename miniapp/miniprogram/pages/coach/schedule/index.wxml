<view class="page-shell">
  <text class="eyebrow">我的排课</text>
  <view class="title">我的团课</view>
  <view class="coach-toolbar">
    <button class="coach-button coach-button--secondary" bindtap="previousWeek">上一周</button>
    <text class="muted">{{weekStart}}</text>
    <button class="coach-button coach-button--secondary" bindtap="nextWeek">下一周</button>
  </view>
  <async-state wx:if="{{mode !== 'ready'}}" mode="{{mode}}" message="{{message}}" bindretry="load" />
  <view wx:else>
    <view wx:for="{{groups}}" wx:key="dateKey" wx:for-item="group">
      <text class="eyebrow coach-day">{{group.dateLabel}}</text>
      <view wx:for="{{group.items}}" wx:key="id" wx:for-item="session" class="coach-card">
        <text class="coach-card__title">{{session.courseName}}</text>
        <text class="coach-card__meta">{{session.timeLabel}} · {{session.roomName}}</text>
        <text class="coach-card__meta">状态 {{session.statusLabel}} · 到课 {{session.capacityLabel}}</text>
        <button class="coach-button" data-id="{{session.id}}" bindtap="roster">查看名册</button>
      </view>
    </view>
  </view>
</view>
