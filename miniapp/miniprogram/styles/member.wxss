.member-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0;
}

.member-toolbar__button {
  min-width: 122rpx;
  margin: 0;
  border: 1rpx solid rgba(23, 63, 53, 0.25);
  border-radius: 999rpx;
  background: transparent;
  color: #173f35;
  font-size: 24rpx;
}

.day-group {
  margin-top: 36rpx;
}

.day-group__title {
  display: block;
  margin-bottom: 16rpx;
  color: #bb6b3d;
  font-family: Georgia, "Noto Serif CJK SC", serif;
  font-size: 30rpx;
}

.member-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(23, 63, 53, 0.12);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
}

.member-card__headline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.member-card__title {
  font-family: Georgia, "Noto Serif CJK SC", serif;
  font-size: 32rpx;
  font-weight: 600;
}

.member-card__tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e7efe9;
  color: #27614f;
  font-size: 20rpx;
}

.member-card__meta {
  display: block;
  margin-top: 10rpx;
  color: #64736e;
  font-size: 24rpx;
  line-height: 1.55;
}

.member-card__action {
  margin: 22rpx 0 0;
  border-radius: 999rpx;
  background: #173f35;
  color: #fffaf1;
  font-size: 24rpx;
}

.feedback {
  margin: 18rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f3ded1;
  color: #883f31;
  font-size: 24rpx;
}

.load-more {
  margin-top: 28rpx;
  border: 0;
  background: transparent;
  color: #27614f;
  font-size: 26rpx;
}
