.admin-header { margin-bottom: 28rpx; }
.admin-toolbar { display: flex; gap: 16rpx; margin: 24rpx 0; }
.admin-input, .admin-picker { box-sizing: border-box; min-height: 76rpx; padding: 18rpx 22rpx; border: 1rpx solid #c8d0cc; border-radius: 16rpx; background: #fff; font-size: 27rpx; }
.admin-input { flex: 1; }
.admin-button { margin: 0; padding: 0 26rpx; border-radius: 16rpx; background: #173f35; color: white; font-size: 26rpx; line-height: 76rpx; }
.admin-button--light { background: #e7ede9; color: #173f35; }
.admin-button--danger { background: #8c3f34; }
.admin-card { margin-bottom: 20rpx; padding: 26rpx; border: 1rpx solid rgba(23,63,53,.14); border-radius: 22rpx; background: rgba(255,255,255,.88); }
.admin-card__head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.admin-card__title { font-size: 32rpx; font-weight: 650; }
.admin-card__meta { display: block; margin-top: 10rpx; color: #64736e; font-size: 25rpx; line-height: 1.55; }
.admin-badge { flex: none; padding: 7rpx 14rpx; border-radius: 999rpx; background: #e4ece8; color: #173f35; font-size: 22rpx; }
.admin-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.admin-actions button { margin: 0; padding: 0 20rpx; border-radius: 999rpx; font-size: 23rpx; line-height: 58rpx; }
.admin-form { margin: 24rpx 0; padding: 26rpx; border-radius: 22rpx; background: #fff; }
.admin-label { display: block; margin: 18rpx 0 8rpx; color: #42524d; font-size: 24rpx; }
.admin-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.admin-metric { padding: 24rpx; border-radius: 20rpx; background: #fff; }
.admin-metric__value { display: block; margin-top: 8rpx; color: #173f35; font-size: 38rpx; font-weight: 700; }
.admin-error { display: block; margin: 18rpx 0; color: #a13e31; font-size: 25rpx; }
.admin-empty { padding: 60rpx 20rpx; color: #64736e; text-align: center; }
.admin-check { display: inline-flex; align-items: center; margin: 18rpx 22rpx 18rpx 0; font-size: 25rpx; }
.admin-textarea { width: 100%; min-height: 180rpx; }
