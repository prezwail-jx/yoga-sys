page {
  min-height: 100%;
  background: #f4f0e8;
  color: #18312b;
  font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 36rpx 64rpx;
}

.eyebrow {
  color: #bb6b3d;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.title {
  margin: 16rpx 0 12rpx;
  font-family: Georgia, "Noto Serif CJK SC", serif;
  font-size: 54rpx;
  line-height: 1.15;
}

.muted {
  color: #64736e;
  font-size: 28rpx;
  line-height: 1.65;
}

.panel {
  margin-top: 36rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(23, 63, 53, 0.15);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 50rpx rgba(23, 63, 53, 0.08);
}

.primary-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #173f35;
  color: #fffaf1;
  font-size: 28rpx;
}

.primary-button[disabled] {
  background: #8a9994;
  color: #e9eceb;
}
