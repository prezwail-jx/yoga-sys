APP_ENV=production
APP_NAME=yoga-sys-backend-prod
LOG_LEVEL=INFO
LOG_FORMAT=json

DATABASE_URL=postgresql+psycopg://yoga_prod:<production-database-password>@postgres-prod:5432/yoga_sys_prod
CORS_ORIGINS=https://yoga.tuitukj.com

JWT_SECRET=<replace-with-production-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

WECHAT_AUTH_ENABLED=true
WECHAT_PROVIDER=real
WECHAT_APP_ID=wx9fc61b966bf4e207
WECHAT_APP_SECRET=<replace-with-production-app-secret>
WECHAT_IDENTITY_PEPPER=<replace-with-production-32-plus-char-pepper>
WECHAT_SOURCE_FINGERPRINT_PEPPER=<replace-with-another-production-pepper>
WECHAT_API_TIMEOUT_SECONDS=5
WECHAT_BINDING_CHALLENGE_MINUTES=10
WECHAT_BINDING_MAX_ATTEMPTS=5
WECHAT_BINDING_SOURCE_MAX_ATTEMPTS=20
WECHAT_BINDING_SOURCE_WINDOW_SECONDS=600

OTEL_ENABLED=false

# Seed-only block: set these, run the one-time seed, then remove them.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<replace-with-strong-password>
COACH_USERNAME=coach
COACH_PASSWORD=<replace-with-strong-password>
